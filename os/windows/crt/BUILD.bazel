# The C runtime that toolchains should target on Windows platforms.
#
# Usage:
#
#   * Choosing the CRT: set `:preference` to a ranking of options, e.g.
#     `--@platforms_contrib//os/windows/crt:preference=static-ucrt`. An empty ranking, the default,
#     leaves the choice to the toolchain.
#
#   * Following the choice in a toolchain or rule: use `:ucrt_preferred`, `:msvcrt_preferred`,
#     `:none_preferred`, `:requires_static`, `:requires_dynamic` and `:unset` as `select()` keys or
#     in `toolchain.target_settings` or read the `PreferredWindowsCrtInfo` provider (from `crt.bzl`)
#     of `:preferred` in a rule implementation.
#
# To make code depend on the CRT that it's actually compiled against, use the `config_setting`s in
# `@rules_cc//cc/libc` instead.

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":crt_private.bzl", "CRT_FLAVORS", "NO_CRT", "crt_preference_flag", "preferred_windows_crt")

bzl_library(
    name = "crt_bzl",
    srcs = ["crt.bzl"],
    visibility = ["//visibility:public"],
)

crt_preference_flag(
    name = "preference",
    build_setting_default = [],
    # Applies to the target platform only, so that a ranking doesn't affect tools built for the exec
    # platform.
    scope = "target",
    visibility = ["//visibility:public"],
)

preferred_windows_crt(
    name = "preferred",
    visibility = ["//visibility:public"],
)

preferred_windows_crt(
    name = "preferred_requires_static",
    requires_static = True,
)

[
    config_setting(
        name = "{}_preferred".format(flavor),
        flag_values = {":preferred": flavor},
        visibility = ["//visibility:public"],
    )
    for flavor in CRT_FLAVORS + [NO_CRT]
]

# Matches if the CRT has to be linked statically (/MT), which affects compilation as well as linking.
config_setting(
    name = "requires_static",
    flag_values = {":preferred_requires_static": "true"},
    visibility = ["//visibility:public"],
)

# Matches if the CRT has to be linked dynamically (/MD), which affects compilation as well as linking.
config_setting(
    name = "requires_dynamic",
    flag_values = {":preferred_requires_static": "false"},
    visibility = ["//visibility:public"],
)

# Matches Windows platforms with an empty ranking.
config_setting(
    name = "unset",
    flag_values = {":preferred": "unset"},
    visibility = ["//visibility:public"],
)
